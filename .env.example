# Copy to .env (never commit .env). All values have safe defaults in compose.yaml.
SAH_VERSION=0.1.0
SAH_DATA_ROOT=/srv/spark-ai-hub          # persistent data root (secrets in $SAH_DATA_ROOT/config/secrets)
SAH_PROXY_PORT=8080                      # bound to 127.0.0.1 only; Tailscale Serve proxies HTTPS to it
SAH_PUBLIC_BASE_URL=https://your-spark.your-tailnet.ts.net   # address people use (install.sh fills it from Tailscale)
SAH_ORG_NAME=                            # optional; the first-run setup (or Settings → System) sets it from the UI
SAH_COOKIE_SECURE=true
SAH_LOG_LEVEL=INFO
SAH_DOCKER_GID=988                       # host 'docker' group id (stat -c %g /var/run/docker.sock)
SAH_VLLM_IMAGE=nvcr.io/nvidia/vllm:26.09-py3
SAH_IMPORT_HF_CACHE=$HOME/.cache/huggingface   # mounted read-only for "import existing models"
